PORT=5000
# Set this to your MongoDB Atlas connection string from Database > Connect > Drivers.
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/mern_tradehub?retryWrites=true&w=majority
# Set to true only for temporary, non-persistent local development.
USE_MEMORY_DB_FALLBACK=false
JWT_SECRET=replace_with_a_strong_secret_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Optional: Add your Stripe test secret key (sk_test_...) to enable real Stripe Checkout.
# Leave blank to use the built-in interactive Test Payment Gateway.
STRIPE_SECRET_KEY=
